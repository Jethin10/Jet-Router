# Jet Router environment contract
# Copy this file to .env and replace every change-me value before deployment.

# Required
JWT_SECRET=change-me-generate-at-least-32-random-bytes
API_KEY_SECRET=change-me-generate-a-different-32-byte-secret
INITIAL_PASSWORD=change-me-use-a-strong-unique-password
DATA_DIR=/app/data

# Recommended runtime variables
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Recommended security and ops variables
MACHINE_ID_SALT=change-me-generate-another-random-secret
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
JET_ROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb
# The npm self-updater is disabled for source/Docker deployments.
JET_ROUTER_ENABLE_NPM_UPDATER=false
# Never enable this outside an isolated throwaway environment.
JET_ROUTER_ALLOW_INSECURE_DEFAULTS=false

# Public URL configuration. Use your HTTPS origin when deployed behind a proxy.
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Optional cloud sync target. Disabled when blank.
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional Google OAuth application credentials. Required only for the
# Antigravity/Gemini OAuth login flows; API-key connections do not need them.
# JET_ROUTER_ANTIGRAVITY_CLIENT_ID=
# JET_ROUTER_ANTIGRAVITY_CLIENT_SECRET=
# JET_ROUTER_GOOGLE_CLIENT_ID=
# JET_ROUTER_GOOGLE_CLIENT_SECRET=

# Optional instance label
INSTANCE_NAME=Jet Router
